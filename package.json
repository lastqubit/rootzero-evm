{
  "name": "@rootzero/contracts",
  "version": "1.38.0",
  "description": "Solidity contracts and protocol building blocks for rootzero hosts and commands.",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "files": [
    "*.sol",
    "contracts/**/*.sol",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.0.7"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "node scripts/run-tests.mjs test",
    "bench": "node scripts/run-tests.mjs bench",
    "test:all": "hardhat test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepare:package": "node scripts/prepare-package.mjs",
    "pack:package": "npm run prepare:package && npm pack ./dist/package",
    "publish:package": "npm run typecheck && npm test && npm run prepare:package && npm publish ./dist/package --access public"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.12.0",
    "mocha": "^11.8.0",
    "typescript": "~5.9.3"
  }
}
