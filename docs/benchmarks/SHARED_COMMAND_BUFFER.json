  "variants": {
    "current": "Production runCommand, existing optional context/output logs without account.",
    "separate": "Existing openContext/finish output buffer plus mandatory endpoint/account/context event and optional separate output event. One Execution struct allocation, same callback.",
    "shared": "One growable buffer, compact descriptor, mandatory endpoint/account and selected lanes in one completion event. Aliased output bytes, ordinary Solidity ABI return.",
    "shared-direct": "Same shared runner, followed by in-place ABI framing and assembly RETURN at the external boundary. Same (bytes,uint) ABI; cannot be used as an internal early return."
  },
  "descriptor": {
    "bits": "0..2: log state/input/output; 3: state capacity source; 4: equal-stride byte capacity; 8..39: source stride; 40..71: output stride; 72..103: source key; 104..119: fixed prefix size",
    "optimizations": [
      "Precompute fixed prefix size and logging selections.",
      "Use source byte length directly as output capacity for equal fixed-size source/output blocks.",
      "Copy adjacent selected state/input containers together.",
      "Write output in its final event region; reacquire buffer after growth; log before replacing prefix with return framing."
    ]
  },
  "verification": {
    "benchmarkTests": 3,
    "configurations": 67,
    "variantsPerConfiguration": 4,
    "checks": [
      "Exact output and budget credit for every variant.",
      "Exact event bytes and count for all eight lane masks, including empty batches.",
      "Canonical raw ABI bytes for direct-return variant.",
      "Returned output pointer aliases the final allocation; expected relocation under forced growth.",
      "Output survives later allocations; callback neighbors survive writes and growth.",
      "Malformed contexts and callback reverts match the current runner."
    ],
    "typecheck": "passed"
  },
  "limitations": [
    "Synthetic fixed-size balance callbacks; production host hooks and nested log ordering were not benchmarked.",
    "Mandatory records add cost to commands that currently emit no execution logs.",
    "Normal Solidity ABI encoding still copies returned bytes and can negate shared-buffer savings.",
    "Forced growth can copy the event prefix as well as output; one allocation is conditional on sufficient capacity.",
    "Combined execution record moves to completion, after any callback or nested events.",
    "Shared buffer is destructively finalized; its original event prefix must not be reused after emission.",
    "Gas-left measurements exclude external ABI return encoding and include common harness dispatch overhead. Retained memory is not peak scratch-memory expansion."
  ]
